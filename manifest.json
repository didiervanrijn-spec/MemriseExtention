{
  "manifest_version": 3,
  "name": "Memrise Engine",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.memrise.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.memrise.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
